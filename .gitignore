# R
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Workflow and shared data directories - not versioned
workflows/
shared_data/

# Keep most workflow contents ignored, but allow selected lightweight
# workflow code/report files to be versioned.
!workflows/
workflows/*
!workflows/usa_wind_trend/
workflows/usa_wind_trend/*
!workflows/usa_wind_trend/scripts/
workflows/usa_wind_trend/scripts/*
!workflows/usa_wind_trend/scripts/usa_mast_16_wind_processing_script.R
!workflows/usa_wind_trend/result_data/
workflows/usa_wind_trend/result_data/*
!workflows/usa_wind_trend/result_data/usa_mast_16_wind_methods_results.txt

!workflows/crds_routine_cleaning/
workflows/crds_routine_cleaning/*
!workflows/crds_routine_cleaning/scripts/
workflows/crds_routine_cleaning/scripts/*
!workflows/crds_routine_cleaning/scripts/crds_weekly_cleaning.R

# Allow device_comparison cleaning + plotting scripts (data subfolders stay
# ignored so raw_data/, clean_data/, result_data/, meta_data/ are not committed).
!workflows/device_comparison/
workflows/device_comparison/*
!workflows/device_comparison/scripts/
workflows/device_comparison/scripts/*
!workflows/device_comparison/scripts/*.R

# Allow Version_7 reviewer-revision analysis scripts (added for
# Biosystems Engineering YBENG-D-26-00430 first-revision response).
!workflows/ringversuche_analysis/
workflows/ringversuche_analysis/*
!workflows/ringversuche_analysis/scripts/
workflows/ringversuche_analysis/scripts/*
!workflows/ringversuche_analysis/scripts/*.R
!workflows/ringversuche_analysis/scripts/v7/
!workflows/ringversuche_analysis/scripts/v7/**

# Allow Version_8 reviewer-revision NE/SW relabel + y-clip scripts.
!workflows/ringversuche_analysis/scripts/v8/
!workflows/ringversuche_analysis/scripts/v8/**

# Claude Code context
.claude/
