!workflows/mapping_high_resolution/meta_data/
workflows/mapping_high_resolution/meta_data/*
!workflows/mapping_high_resolution/meta_data/*.txt
!workflows/mapping_high_resolution/plots/
workflows/mapping_high_resolution/plots/*
!workflows/mapping_high_resolution/plots/**/
!workflows/mapping_high_resolution/plots/**/*.png
!workflows/mapping_high_resolution/Manuscript_3_Mapping_high_resolution_concentration_Latex_draft/
