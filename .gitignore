# Allow shared lightweight workflow utility functions.
!workflows/utils/
workflows/utils/*
!workflows/utils/*.R

# Allow device_comparison cleaning + plotting scripts (data subfolders stay
# ignored so raw_data/, clean_data/, result_data/, meta_data/ are not committed).
!workflows/device_comparison/
workflows/device_comparison/*
!workflows/device_comparison/scripts/
workflows/device_comparison/scripts/*
